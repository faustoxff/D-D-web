# Neon Postgres (use the direct, non-pooled host for the long-running game server)
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx.region.aws.neon.tech/dbname?sslmode=verify-full
# Managed Better Auth base URL (Neon console -> Auth -> Configuration)
NEON_AUTH_BASE_URL=https://ep-xxxx.neonauth.region.aws.neon.tech/dbname/auth
ANTHROPIC_API_KEY=
