{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "./src",
    "outDir": "./dist",
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    // Required by @colyseus/schema: ES2022 define-semantics would shadow the @type accessors
    "useDefineForClassFields": false,
    "module": "CommonJS",
    "moduleResolution": "node"
  },
  "include": ["src"],
  "ts-node": {
    "transpileOnly": false,
    "esm": false
  }
}
